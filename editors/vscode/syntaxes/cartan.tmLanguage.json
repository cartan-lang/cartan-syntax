{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "cartan",
  "scopeName": "source.cartan",
  "patterns": [
    { "name": "string.quoted.triple.cartan", "begin": "\"\"\"", "end": "\"\"\"" },
    { "name": "string.quoted.double.cartan", "match": "\"(?:(?:(?:[^\"\\\\\\n])|(?:\\\\.)))*\"" },
    { "name": "comment.line.number-sign.cartan", "match": "#(?:[^\\n]*)" },
    { "name": "constant.language.cartan", "match": "\\b(?:false|none|true)\\b" },
    { "name": "constant.numeric.cartan", "match": "\\b(?:[0-9][_0-9]*)(?:(?:\\.[0-9][_0-9]*))?(?:(?:[eE][+\\-]?[0-9]+))?" },
    { "name": "keyword.control.cartan", "match": "\\b(?:and|as|but|each|else|fiber|fn|fold|for|if|in|locked|match|namespace|not|of|or|param|periodic|reduce|require|state|step|struct|tap|texture|use|when|while|with)\\b" },
    { "name": "keyword.operator.cartan", "match": "\\.\\.=|!=|->|\\.\\.|\\/\\/|::|:=|<-|<=|<>|==|=>|>=|\\?\\?|#|\\*|\\+|-|\\.|\\/|:|;|<|=|>|\\?|@|\\^|\\|" }
  ]
}
